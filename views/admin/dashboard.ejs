<%- include('../partials/admin-head', { title }) %>

<div class="admin-shell dashboard-page">

  <%- include('../partials/admin-nav') %>

  <main class="admin-main">

    <%- include('../partials/flash') %>

    <section class="dashboard-hero">

      <div class="hero-left">

        <span class="hero-badge">
          ADMIN PANEL
        </span>

        <h1>
          <%= data.settings.siteName || 'PROMO WEBSITE' %>
        </h1>

        <p>
          Kelola background, banner promo, tombol menu,
          dan seluruh tampilan website langsung dari dashboard admin.
        </p>

      </div>

      <div class="hero-right">

        <a
          class="hero-btn primary"
          href="/"
          target="_blank"
        >
          Preview Website
        </a>

        <a
          class="hero-btn secondary"
          href="<%= adminPath %>/promos/new"
        >
          Tambah Promo
        </a>

      </div>

    </section>

    <section class="stats-grid">

      <div class="stat-card">

        <div class="stat-top">
          <span class="stat-dot green"></span>
          <span>Total Promo</span>
        </div>

        <strong>
          <%= data.promos.length %>
        </strong>

        <small>
          Semua banner promo website
        </small>

      </div>

      <div class="stat-card">

        <div class="stat-top">
          <span class="stat-dot gold"></span>
          <span>Promo Aktif</span>
        </div>

        <strong>
          <%= data.promos.filter(p=>p.active).length %>
        </strong>

        <small>
          Promo yang sedang tampil
        </small>

      </div>

      <div class="stat-card">

        <div class="stat-top">
          <span class="stat-dot blue"></span>
          <span>Menu Tombol</span>
        </div>

        <strong>
          <%= data.menus.length %>
        </strong>

        <small>
          Total tombol website
        </small>

      </div>

      <div class="stat-card">

        <div class="stat-top">
          <span class="stat-dot red"></span>
          <span>Nama Situs</span>
        </div>

        <strong class="site-name">
          <%= data.settings.siteName || 'WEBSITE' %>
        </strong>

        <small>
          Brand website aktif
        </small>

      </div>

    </section>

    <section class="dashboard-grid">

      <div class="admin-box">

        <div class="box-head">
          <h2>Quick Access</h2>
          <span>Pengaturan cepat website</span>
        </div>

        <div class="quick-links">

          <a href="<%= adminPath %>/settings">

            <div>
              <strong>Background & Header</strong>
              <small>
                Atur logo, background, header website
              </small>
            </div>

            <span>→</span>

          </a>

          <a href="<%= adminPath %>/menus">

            <div>
              <strong>Menu Tombol</strong>
              <small>
                Kelola tombol navigasi website
              </small>
            </div>

            <span>→</span>

          </a>

          <a href="<%= adminPath %>/promos">

            <div>
              <strong>Daftar Promo</strong>
              <small>
                Edit banner promo website
              </small>
            </div>

            <span>→</span>

          </a>

          <a href="<%= adminPath %>/promos/new">

            <div>
              <strong>Tambah Promo Baru</strong>
              <small>
                Tambah promo baru website
              </small>
            </div>

            <span>→</span>

          </a>

        </div>

      </div>

      <div class="admin-box">

        <div class="box-head">
          <h2>Status Website</h2>
          <span>Status sistem website</span>
        </div>

        <div class="status-list">

          <div class="status-item">
            <span>Website</span>
            <b class="online">ONLINE</b>
          </div>

          <div class="status-item">
            <span>Admin Panel</span>
            <b class="online">ACTIVE</b>
          </div>

          <div class="status-item">
            <span>Background</span>
            <b>
              <%= data.settings.backgroundUrl ? 'SET' : 'EMPTY' %>
            </b>
          </div>

          <div class="status-item">
            <span>Header Banner</span>
            <b>
              <%= data.settings.headerImageUrl ? 'SET' : 'EMPTY' %>
            </b>
          </div>

        </div>

      </div>

    </section>

  </main>

</div>

</body>
</html>
