<%- include('../partials/admin-head', { title }) %>

<link
  href="https://cdn.jsdelivr.net/npm/summernote@0.8.20/dist/summernote-lite.min.css"
  rel="stylesheet"
/>

<div class="admin-shell">

  <%- include('../partials/admin-nav') %>

  <main class="admin-main">

    <%- include('../partials/flash') %>

    <div class="page-head">

      <div>
        <span>PROMO</span>

        <h1>
          <%= promo ? 'Edit Promo' : 'Tambah Promo' %>
        </h1>
      </div>

      <a
        class="primary-link"
        href="<%= adminPath %>/promos"
      >
        Kembali
      </a>

    </div>

    <form
      class="admin-card form-grid"
      method="post"
      action="<%= promo ? adminPath + '/promos/' + promo.id : adminPath + '/promos' %>"
      enctype="multipart/form-data"
    >

      <label>

        Judul Promo

        <input
          name="title"
          value="<%= promo ? promo.title : '' %>"
          required
        >

      </label>

      <label>

        Urutan

        <input
          name="sort"
          type="number"
          value="<%= promo ? promo.sort : 1 %>"
        >

      </label>

      <label class="full">

        Image URL

        <input
          name="imageUrl"
          value="<%= promo ? promo.imageUrl : '' %>"
          placeholder="https://...webp"
        >

      </label>

      <label>

        Upload Gambar Promo

        <input
          type="file"
          name="imageFile"
          accept="image/*"
        >

      </label>

      <label>

        Link Klaim / Detail

        <input
          name="linkUrl"
          value="<%= promo ? promo.linkUrl : '' %>"
          placeholder="https://..."
        >

      </label>

      <div class="check-row full">

        <label>
          <input
            type="checkbox"
            name="active"
            <%= !promo || promo.active ? 'checked' : '' %>
          >
          Aktif
        </label>

        <label>
          <input
            type="checkbox"
            name="openDefault"
            <%= promo && promo.openDefault ? 'checked' : '' %>
          >
          Terbuka otomatis
        </label>

      </div>

      <label class="full">

        Keterangan Promo / Syarat Ketentuan

        <textarea
          id="promoEditor"
          name="description"
        ><%= promo ? promo.description : '' %></textarea>

      </label>

      <div class="editor-help full">

        Bisa tambah:
        gambar,
        heading,
        bullet,
        warna,
        tabel,
        video,
        dan gambar bisa diklik ke link lain.

      </div>

      <button class="save-btn full">

        <%= promo ? 'Simpan Promo' : 'Tambah Promo' %>

      </button>

    </form>

  </main>

</div>

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

<script src="https://cdn.jsdelivr.net/npm/summernote@0.8.20/dist/summernote-lite.min.js"></script>

<script>

$(document).ready(function(){

  $('#promoEditor').summernote({

    placeholder:'Isi keterangan promo...',

    tabsize:2,

    height:500,

    dialogsInBody:true,

    disableResizeEditor:false,

    toolbar:[

      ['style',['style']],

      ['font',['bold','italic','underline','clear']],

      ['fontsize',['fontsize']],

      ['color',['color']],

      ['para',['ul','ol','paragraph']],

      ['table',['table']],

      ['insert',['link','picture','video']],

      ['custom',['imageLink']],

      ['view',['fullscreen','codeview']]

    ],

    buttons:{

      imageLink:function(){

        const ui = $.summernote.ui;

        return ui.button({

          contents:'🔗 IMG',

          tooltip:'Tambah Link Pada Gambar',

          click:function(){

            const selectedImg =
              $('.note-editable img').last();

            if(!selectedImg.length){

              alert('Upload gambar dulu');

              return;

            }

            const currentHref =
              selectedImg.parent('a').attr('href') || '';

            const url = prompt(
              'Masukkan link untuk gambar:',
              currentHref
            );

            if(!url) return;

            const finalUrl =
              url.startsWith('http')
                ? url
                : 'https://' + url;

            if(selectedImg.parent('a').length){

              selectedImg
                .parent('a')
                .attr('href',finalUrl)
                .attr('target','_blank');

            }else{

              selectedImg.wrap(
                '<a href="' +
                finalUrl +
                '" target="_blank"></a>'
              );

            }

            $('#promoEditor').summernote(
              'code',
              $('.note-editable').html()
            );

            alert('Link gambar berhasil dipasang');

          }

        }).render();

      }

    }

  });

});

</script>

<script src="/assets/js/admin.js"></script>

</body>
</html>
