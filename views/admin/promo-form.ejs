<%- include('../partials/admin-head', { title }) %>

<div class="admin-shell">

  <%- include('../partials/admin-nav') %>

  <main class="admin-main">

    <%- include('../partials/flash') %>

    <div class="page-head">

      <div>
        <span>PROMO</span>

        <h1>
          <%= promo ? 'Edit Promo' : 'Tambah Promo' %>
        </h1>
      </div>

      <a
        class="primary-link"
        href="<%= adminPath %>/promos"
      >
        Kembali
      </a>

    </div>

    <form
      class="admin-card form-grid"
      method="post"
      action="<%= promo ? adminPath + '/promos/' + promo.id : adminPath + '/promos' %>"
      enctype="multipart/form-data"
    >

      <label>
        Judul Promo

        <input
          name="title"
          value="<%= promo ? promo.title : '' %>"
          required
        >
      </label>

      <label>
        Urutan

        <input
          name="sort"
          type="number"
          value="<%= promo ? promo.sort : 1 %>"
        >
      </label>

      <label class="full">

        Image URL

        <input
          name="imageUrl"
          value="<%= promo ? promo.imageUrl : '' %>"
          placeholder="https://...webp"
        >

      </label>

      <label>

        Upload Gambar Promo

        <input
          type="file"
          name="imageFile"
          accept="image/*"
        >

      </label>

      <label>

        Link Klaim / Detail

        <input
          name="linkUrl"
          value="<%= promo ? promo.linkUrl : '' %>"
          placeholder="https://..."
        >

      </label>

      <div class="check-row full">

        <label>
          <input
            type="checkbox"
            name="active"
            <%= !promo || promo.active ? 'checked' : '' %>
          >
          Aktif
        </label>

        <label>
          <input
            type="checkbox"
            name="openDefault"
            <%= promo && promo.openDefault ? 'checked' : '' %>
          >
          Terbuka otomatis
        </label>

      </div>

      <label class="full">

        Keterangan Promo / Syarat Ketentuan

        <textarea
          id="promoEditor"
          name="description"
          rows="18"
        ><%= promo ? promo.description : '' %></textarea>

      </label>

      <div class="editor-help full">

        Editor mendukung:
        gambar,
        tabel,
        heading,
        bullet,
        warna teks,
        dan link.

      </div>

      <button class="save-btn full">

        <%= promo ? 'Simpan Promo' : 'Tambah Promo' %>

      </button>

    </form>

  </main>

</div>

<script src="https://cdn.tiny.cloud/1/no-api-key/tinymce/6/tinymce.min.js"></script>

<script>

tinymce.init({

  selector:'#promoEditor',

  height:520,

  menubar:false,

  branding:false,

  promotion:false,

  plugins:[
    'lists',
    'link',
    'image',
    'table',
    'code',
    'fullscreen',
    'media',
    'autolink',
    'wordcount'
  ],

  toolbar:
    'undo redo | ' +
    'blocks fontsize | ' +
    'bold italic underline strikethrough | ' +
    'alignleft aligncenter alignright alignjustify | ' +
    'bullist numlist outdent indent | ' +
    'image media link table | ' +
    'forecolor backcolor | ' +
    'removeformat code fullscreen',

  fontsize_formats:
    '12px 14px 16px 18px 20px 24px 28px 32px',

  content_style:`

    body{
      font-family:Arial,sans-serif;
      font-size:15px;
      line-height:1.8;
      padding:16px;
      background:#ffffff;
      color:#111111;
    }

    p{
      margin:0 0 14px;
    }

    img{
      max-width:100%;
      height:auto;
      border-radius:10px;
    }

    table{
      width:100%;
      border-collapse:collapse;
      margin-top:14px;
    }

    table td,
    table th{
      border:1px solid #ddd;
      padding:10px;
    }

    h1,h2,h3{
      margin-top:18px;
    }

  `

});

</script>

<script src="/assets/js/admin.js"></script>

</body>
</html>
