<%- include('../partials/admin-head', { title }) %>
<main class="login-page">
  <form class="login-card" method="post" action="<%= adminPath %>/login">
    <div class="login-logo">R</div>
    <h1>Admin Login</h1>
    <p>PINK TIGER.</p>
    <%- include('../partials/flash') %>
    <label>ID Admin<input name="username" autocomplete="username" required></label>
    <label>Password<input name="password" type="password" autocomplete="current-password" required></label>
    <button type="submit">Masuk Admin</button>
  </form>
</main>
</body></html>
